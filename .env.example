# DevWeaver-Lite environment variables
#
# Required: GITHUB_TOKEN (Cursor, Windsurf, Claude Desktop only -- not needed for VS Code Copilot)
# Optional: CONTEXT7_API_KEY (public endpoint works without a key)
# Conditional: INFLUXDB_* (only for projects with an IoT/InfluxDB module)
#
# For VS Code Copilot: no environment variables required.
# GitHub MCP uses the native Copilot HTTP endpoint (https://api.githubcopilot.com/mcp).

# Required for Cursor, Windsurf, Claude Desktop (not needed for VS Code Copilot)
GITHUB_TOKEN=ghp_your_token_here

# Optional: public endpoint works without a key
CONTEXT7_API_KEY=your_context7_key_here

# Conditional: InfluxDB MCP (only when target project has an IoT module)
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=your_influxdb_token_here
# INFLUXDB_ORG=your_org

# Note: Playwright and Filesystem MCPs use npx -y and auto-download on first use.
# Node.js >= 18 is required only if you use these optional MCPs.
